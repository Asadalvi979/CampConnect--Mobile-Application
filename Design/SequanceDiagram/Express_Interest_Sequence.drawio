nt x="1020" y="872" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="[else – project exists and is eligible]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="875" width="800" height="20" as="geometry"/></mxCell><mxCell id="c30" value="11: Check existing ProjectInterest&lt;br&gt;(project_id, user_id)" style="endArrow=block;endFill=1;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="646" y="916" as="sourcePoint"/><mxPoint x="914" y="916" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="Existing interest or none" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="914" y="952" as="sourcePoint"/><mxPoint x="646" y="952" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="[Alt 3 – Duplicate interest already exists]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="991" width="800" height="20" as="geometry"/></mxCell><mxCell id="c34" value="409: Interest already submitted" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="634" y="1032" as="sourcePoint"/><mxPoint x="366" y="1032" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="Show already-submitted message" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="354" y="1068" as="sourcePoint"/><mxPoint x="100" y="1068" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="1090" as="sourcePoint"/><mxPoint x="1000" y="1090" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="[else – no existing interest]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="1093" width="800" height="20" as="geometry"/></mxCell><mxCell id="c38" value="12: INSERT ProjectInterest&lt;br&gt;(project_id, user_id)" style="endArrow=block;endFill=1;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="646" y="1144" as="sourcePoint"/><mxPoint x="914" y="1144" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="[Alt 4 – Database error]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="1183" width="800" height="20" as="geometry"/></mxCell><mxCell id="c40" value="Error: record not saved" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="914" y="1224" as="sourcePoint"/><mxPoint x="646" y="1224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="500: Failed to submit interest" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="634" y="1260" as="sourcePoint"/><mxPoint x="366" y="1260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="Show failure message" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="354" y="1296" as="sourcePoint"/><mxPoint x="100" y="1296" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="1318" as="sourcePoint"/><mxPoint x="980" y="1318" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="[else – Successful submission]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="1321" width="800" height="20" as="geometry"/></mxCell><mxCell id="c45" value="13: Insert confirmed" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="914" y="1362" as="sourcePoint"/><mxPoint x="646" y="1362" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="14: Success: interest submitted" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="634" y="1398" as="sourcePoint"/><mxPoint x="366" y="1398" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="15: Show confirmation message" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="354" y="1434" as="sourcePoint"/><mxPoint x="100" y="1434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rules" value="&lt;b&gt;Business rules&lt;/b&gt;&lt;br&gt;• Only authenticated users can submit project interest (JWT required).&lt;br&gt;• The ProjectOpportunity must exist and be eligible to receive interest.&lt;br&gt;• ProjectInterest is keyed by (project_id, user_id): no duplicate interest per student and project.&lt;br&gt;• Uses existing entities only: ProjectOpportunity and ProjectInterest. The project owner reviews interests in a separate diagram.&lt;br&gt;• Normal HTTPS REST requests only; no WebSockets or real-time messaging." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="1544" width="1000" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>