geometry"><mxPoint x="764" y="3933" as="sourcePoint"/><mxPoint x="446" y="3933" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c151" value="Show «Cannot send message»" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="434" y="3971" as="sourcePoint"/><mxPoint x="146" y="3971" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c152" value="C13. Open chat with Student A" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1374" y="4081" as="sourcePoint"/><mxPoint x="446" y="4081" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c153" value="C14. GET /api/conversations/{id}/messages" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="446" y="4121" as="sourcePoint"/><mxPoint x="764" y="4121" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c154" value="C15. SELECT Friendship + Participant (B)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="776" y="4161" as="sourcePoint"/><mxPoint x="1094" y="4161" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c155" value="Friendship active? B is participant?" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1094" y="4199" as="sourcePoint"/><mxPoint x="776" y="4199" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c156" value="C16. SELECT Message (+ MessageAttachment)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="776" y="4281" as="sourcePoint"/><mxPoint x="1094" y="4281" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c157" value="Messages + attachments" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1094" y="4319" as="sourcePoint"/><mxPoint x="776" y="4319" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c158" value="200 OK {authorized messages}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="764" y="4357" as="sourcePoint"/><mxPoint x="446" y="4357" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c159" value="Show conversation messages" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="446" y="4395" as="sourcePoint"/><mxPoint x="1374" y="4395" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c160" value="403 Forbidden (access denied)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="764" y="4471" as="sourcePoint"/><mxPoint x="446" y="4471" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c161" value="Show «Access denied»" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="446" y="4509" as="sourcePoint"/><mxPoint x="1374" y="4509" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c162" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="776" y="1602" as="sourcePoint"/><mxPoint x="782" y="1626" as="targetPoint"/><Array as="points"><mxPoint x="816" y="1602"/><mxPoint x="816" y="1626"/></Array></mxGeometry></mxCell><mxCell id="c163" value="B4. Verify auth user = receiver" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="822" y="1604" width="280" height="20" as="geometry"/></mxCell><mxCell id="c164" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="776" y="2916" as="sourcePoint"/><mxPoint x="782" y="2940" as="targetPoint"/><Array as="points"><mxPoint x="816" y="2916"/><mxPoint x="816" y="2940"/></Array></mxGeometry></mxCell><mxCell id="c165" value="C5. Reuse existing Conversation" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="822" y="2918" width="280" height="20" as="geometry"/></mxCell><mxCell id="c166" value="Not the intended receiver (or request not Pending): 403 Forbidden, no changes made." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1150" y="1640" width="200" height="55" as="geometry"/></mxCell><mxCell id="c167" value="NO Friendship record is created for a rejected request." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1150" y="2177" width="200" height="55" as="geometry"/></mxCell><mxCell id="c168" value="Student A receives the result as a stored Notification, fetched with a normal API request (no real-time push in Release 1). Only an Accepted FriendRequest creates an active Friendship." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="2416" width="990" height="40" as="geometry"/></mxCell><mxCell id="c169" value="Precondition: FriendRequest was Accepted, so an active Friendship exists. Rejected request, no Friendship, or removed Friendship = private messaging denied." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="250" y="2518" width="1040" height="40" as="geometry"/></mxCell><mxCell id="c170" value="friendship_id stored in Conversation = authorization relationship." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1150" y="3164" width="200" height="55" as="geometry"/></mxCell><mxCell id="c171" value="Release 1: no WebSockets, Socket.IO or real-time delivery. Student B retrieves messages with a normal API request (text, image and file messages alike)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="250" y="4001" width="1040" height="40" as="geometry"/></mxCell><mxCell id="c172" value="Mentorship is a separate authorization system: accepting a MentorshipRequest does NOT create a Friendship, and mentorship-based conversations use mentorship_id (not shown here)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="250" y="4539" width="1040" height="40" as="geometry"/></mxCell><mxCell id="c173" value="BUSINESS RULES&lt;br&gt;1. Only an Accepted FriendRequest creates an active Friendship.&lt;br&gt;2. Only active friends can use friendship-based private messaging (Conversation.friendship_id is the authorization relationship).&lt;br&gt;3. Mentorship is a separate authorization system; accepting a MentorshipRequest never auto-creates a Friendship; mentorship conversations use mentorship_id.&lt;br&gt;4. Release 1 uses plain request/response API calls only: no WebSockets, Socket.IO or real-time delivery. Text, image and file messages use normal API requests.&lt;br&gt;5. The acting user is taken from the authenticated session; only the intended receiver may accept or reject a FriendRequest.&lt;br&gt;Entities used: FriendRequest, Friendship, Conversation, ConversationParticipant, Message, MessageAttachment (plus User and Notification records)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="4633" width="1420" height="168" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>