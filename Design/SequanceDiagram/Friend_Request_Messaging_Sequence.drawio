Size=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="434" y="3409" as="sourcePoint"/><mxPoint x="146" y="3409" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c140" value="C8. Write &amp;amp; send message (text/image/file)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="146" y="3465" as="sourcePoint"/><mxPoint x="434" y="3465" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c141" value="C9. POST /api/conversations/{id}/messages" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="446" y="3505" as="sourcePoint"/><mxPoint x="764" y="3505" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c142" value="C10. SELECT Friendship + Participant (A)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="776" y="3545" as="sourcePoint"/><mxPoint x="1094" y="3545" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c143" value="Friendship active? A is participant?" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1094" y="3583" as="sourcePoint"/><mxPoint x="776" y="3583" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c144" value="C11. INSERT Message (sender = A, content)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="776" y="3665" as="sourcePoint"/><mxPoint x="1094" y="3665" as="targetPoint"/>