 as="sourcePoint"/><mxPoint x="1004" y="1172" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="[else – Successful publication]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="136" y="1175" width="800" height="20" as="geometry"/></mxCell><mxCell id="c37" value="12: Insert confirmed" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="914" y="1216" as="sourcePoint"/><mxPoint x="646" y="1216" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="13: Success: announcement published" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="634" y="1252" as="sourcePoint"/><mxPoint x="366" y="1252" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="14: Show Announcement Published" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="354" y="1288" as="sourcePoint"/><mxPoint x="100" y="1288" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rules" value="&lt;b&gt;Business rules&lt;/b&gt;&lt;br&gt;• Only authenticated users with the Admin role can create and publish announcements; the backend checks the role before creating anything.&lt;br&gt;• Uses the existing Announcement entity only (announcement_id, admin_id, title, content, status, published_at). No new entities, fields or status values.&lt;br&gt;• ERD note: Announcement.status is an ENUM whose values are not listed in the ERD, so none are shown here.&lt;br&gt;• Retrieval, editing and deletion are out of scope. Normal HTTPS REST requests only; no WebSockets or real-time communication." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="1398" width="1000" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>