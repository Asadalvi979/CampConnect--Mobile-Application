 edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="74" y="1511" as="sourcePoint"/><mxPoint x="1486" y="1511" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="[JWT is invalid, missing, or expired]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="996" y="711" width="560" height="18" as="geometry"/></mxCell><mxCell id="c15" value="[JWT valid: user authenticated]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="996" y="869" width="560" height="18" as="geometry"/></mxCell><mxCell id="c16" value="[Required information is missing or invalid]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="996" y="1084" width="560" height="18" as="geometry"/></mxCell><mxCell id="c17" value="[Project information is valid]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="996" y="1242" width="560" height="18" as="geometry"/></mxCell><mxCell id="c18" value="[MariaDB fails to save the project]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="996" y="1357" width="560" height="18" as="geometry"/></mxCell><mxCell id="c19" value="[Project saved successfully]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="996" y="1515" width="560" height="18" as="geometry"/></mxCell><mxCell id="c20" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1354" y="250" width="12" height="38" as="geometry"/></mxCell><mxCell id="c21" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="974" y="210" width="12" height="116" as="geometry"/></mxCell><mxCell id="c22" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="594" y="170" width="12" height="194" as="geometry"/></mxCell><mxCell id="c23" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="244" y="164" width="12" height="206" as="geometry"/></mxCell><mxCell id="c24" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="594" y="404" width="12" height="38" as="geometry"/></mxCell><mxCell id="c25" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="244" y="398" width="12" height="50" as="geometry"/></mxCell><mxCell id="c26" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="980" y="668" width="12" height="24" as="geometry"/></mxCell><mxCell id="c27" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="980" y="925" width="12" height="24" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="980" y="1041" width="12" height="24" as="geometry"/></mxCell><mxCell id="c29" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1354" y="1300" width="12" height="38" as="geometry"/></mxCell><mxCell id="c30" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="974" y="576" width="12" height="995" as="geometry"/></mxCell><mxCell id="c31" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="594" y="536" width="12" height="1073" as="geometry"/></mxCell><mxCell id="c32" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="244" y="530" width="12" height="1085" as="geometry"/></mxCell><mxCell id="c33" value="1. Open Project Collaboration section" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="256" y="170" as="sourcePoint"/><mxPoint x="594" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="2. GET /api/project-opportunities" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="606" y="210" as="sourcePoint"/><mxPoint x="974" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="3. SELECT ProjectOpportunity (available)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="986" y="250" as="sourcePoint"/><mxPoint x="1354" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="Opportunity information" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1354" y="288" as="sourcePoint"/><mxPoint x="986" y="288" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="200 OK {opportunities}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="974" y="326" as="sourcePoint"/><mxPoint x="606" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="Display project opportunities" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="364" as="sourcePoint"/><mxPoint x="256" y="364" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="4. Tap «Create Project»" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="256" y="404" as="sourcePoint"/><mxPoint x="594" y="404" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="Show project creation form" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="442" as="sourcePoint"/><mxPoint x="256" y="442" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="5. Enter project details; tap «Publish»" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="256" y="536" as="sourcePoint"/><mxPoint x="594" y="536" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="6. POST /api/project-opportunities + JWT" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="606" y="576" as="sourcePoint"/><mxPoint x="974" y="576" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="401 Unauthorized" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="974" y="811" as="sourcePoint"/><mxPoint x="606" y="811" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="Show authentication error" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="849" as="sourcePoint"/><mxPoint x="256" y="849" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="400 Validation error" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="974" y="1184" as="sourcePoint"/><mxPoint x="606" y="1184" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="Show relevant error" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="1222" as="sourcePoint"/><mxPoint x="256" y="1222" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="10. INSERT ProjectOpportunity (owner = user)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="986" y="1300" as="sourcePoint"/><mxPoint x="1354" y="1300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="Record created / DB error" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1354" y="1338" as="sourcePoint"/><mxPoint x="986" y="1338" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="500 Project creation failed" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="974" y="1457" as="sourcePoint"/><mxPoint x="606" y="1457" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="Show «Project could not be created»" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="1495" as="sourcePoint"/><mxPoint x="256" y="1495" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="201 Created {project}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="974" y="1571" as="sourcePoint"/><mxPoint x="606" y="1571" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="Display published project" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="1609" as="sourcePoint"/><mxPoint x="256" y="1609" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="986" y="668" as="sourcePoint"/><mxPoint x="992" y="692" as="targetPoint"/><Array as="points"><mxPoint x="1026" y="668"/><mxPoint x="1026" y="692"/></Array></mxGeometry></mxCell><mxCell id="c54" value="7. Verify JWT" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1032" y="670" width="280" height="20" as="geometry"/></mxCell><mxCell id="c55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="986" y="925" as="sourcePoint"/><mxPoint x="992" y="949" as="targetPoint"/><Array as="points"><mxPoint x="1026" y="925"/><mxPoint x="1026" y="949"/></Array></mxGeometry></mxCell><mxCell id="c56" value="8. Check user may create projects" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1032" y="927" width="280" height="20" as="geometry"/></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="986" y="1041" as="sourcePoint"/><mxPoint x="992" y="1065" as="targetPoint"/><Array as="points"><mxPoint x="1026" y="1041"/><mxPoint x="1026" y="1065"/></Array></mxGeometry></mxCell><mxCell id="c58" value="9. Validate project information" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1032" y="1043" width="280" height="20" as="geometry"/></mxCell><mxCell id="c59" value="Form fields: title, description, required skills, teammates needed, category." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="456" width="320" height="40" as="geometry"/></mxCell><mxCell id="c60" value="Body: title, description, required skills, teammates needed, category." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="590" width="320" height="40" as="geometry"/></mxCell><mxCell id="c61" value="No project record is created." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="748" width="320" height="25" as="geometry"/></mxCell><mxCell id="c62" value="Only authenticated, authorized users can create project opportunities." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="963" width="320" height="40" as="geometry"/></mxCell><mxCell id="c63" value="No project record is created." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="1121" width="320" height="25" as="geometry"/></mxCell><mxCell id="c64" value="No success message is displayed." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="1394" width="320" height="25" as="geometry"/></mxCell><mxCell id="c65" value="Creating a ProjectOpportunity does NOT create a project team. Other users express interest through a separate workflow." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="250" y="1671" width="1050" height="25" as="geometry"/></mxCell><mxCell id="c66" value="BUSINESS RULES &amp;amp; NOTES&lt;br&gt;1. Only authenticated (valid JWT) and authorized users can create project opportunities; the JWT is verified first.&lt;br&gt;2. Title and description are validated; required skills and teammates needed are validated according to configured rules.&lt;br&gt;3. A ProjectOpportunity belongs to its creating user. It is the only entity used (existing ERD); no new entities are introduced.&lt;br&gt;4. Creating a project opportunity does NOT automatically create a project team; interest is expressed in a separate workflow.&lt;br&gt;5. HTTPS REST with Email OTP + JWT; backend framework TBD; no WebSockets or real-time communication." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1750" width="1500" height="146" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>