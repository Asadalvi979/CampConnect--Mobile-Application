t="1"><mxGeometry x="112" y="1591" width="1312" height="232" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="762" as="sourcePoint"/><mxPoint x="1460" y="762" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="64" y="1050" as="sourcePoint"/><mxPoint x="1448" y="1050" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="88" y="1553" as="sourcePoint"/><mxPoint x="1436" y="1553" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="112" y="1709" as="sourcePoint"/><mxPoint x="1424" y="1709" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="[Invalid file type OR file exceeds size limit OR required information missing]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="856" y="578" width="560" height="18" as="geometry"/></mxCell><mxCell id="c18" value="[Validation succeeds]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="856" y="766" width="560" height="18" as="geometry"/></mxCell><mxCell id="c19" value="[File upload fails]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="856" y="881" width="560" height="18" as="geometry"/></mxCell><mxCell id="c20" value="[File stored; unique file_reference / storage path returned]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="856" y="1054" width="560" height="18" as="geometry"/></mxCell><mxCell id="c21" value="[File uploaded but Resource record creation fails]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="856" y="1360" width="560" height="18" as="geometry"/></mxCell><mxCell id="c22" value="[Resource record created successfully]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="856" y="1557" width="560" height="18" as="geometry"/></mxCell><mxCell id="c23" value="[Automated validation / risk checks flag the resource]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="856" y="1594" width="560" height="18" as="geometry"/></mxCell><mxCell id="c24" value="[No flags raised: status = Published]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="856" y="1713" width="560" height="18" as="geometry"/></mxCell><mxCell id="c25" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="524" y="170" width="12" height="38" as="geometry"/></mxCell><mxCell id="c26" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="244" y="164" width="12" height="50" as="geometry"/></mxCell><mxCell id="c27" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="524" y="248" width="12" height="38" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="244" y="242" width="12" height="50" as="geometry"/></mxCell><mxCell id="c29" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="840" y="404" width="12" height="24" as="geometry"/></mxCell><mxCell id="c30" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="840" y="535" width="12" height="24" as="geometry"/></mxCell><mxCell id="c31" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1394" y="824" width="12" height="38" as="geometry"/></mxCell><mxCell id="c32" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="840" y="1110" width="12" height="24" as="geometry"/></mxCell><mxCell id="c33" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1124" y="1174" width="12" height="38" as="geometry"/></mxCell><mxCell id="c34" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1394" y="1423" width="12" height="38" as="geometry"/></mxCell><mxCell id="c35" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="834" y="366" width="12" height="1403" as="geometry"/></mxCell><mxCell id="c36" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="524" y="326" width="12" height="1481" as="geometry"/></mxCell><mxCell id="c37" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="244" y="320" width="12" height="1493" as="geometry"/></mxCell><mxCell id="c38" value="1. Open Upload Resource screen" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="256" y="170" as="sourcePoint"/><mxPoint x="524" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="Display upload form" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="208" as="sourcePoint"/><mxPoint x="256" y="208" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="2. Enter details &amp;amp; select file" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="256" y="248" as="sourcePoint"/><mxPoint x="524" y="248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="Show entered details + selected file" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="286" as="sourcePoint"/><mxPoint x="256" y="286" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="3. Tap «Upload»" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="256" y="326" as="sourcePoint"/><mxPoint x="524" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="4. POST /api/resources + JWT {details, file}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="536" y="366" as="sourcePoint"/><mxPoint x="834" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="400 Bad Request {validation error}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="708" as="sourcePoint"/><mxPoint x="536" y="708" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="Show validation error" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="746" as="sourcePoint"/><mxPoint x="256" y="746" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="7. Upload file" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry x="0.529" relative="1" as="geometry"><mxPoint x="846" y="824" as="sourcePoint"/><mxPoint x="1394" y="824" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="file_reference / upload error" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry x="-0.529" relative="1" as="geometry"><mxPoint x="1394" y="862" as="sourcePoint"/><mxPoint x="846" y="862" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="502 Bad Gateway {upload failed}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="996" as="sourcePoint"/><mxPoint x="536" y="996" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="Show «File upload failed»" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="1034" as="sourcePoint"/><mxPoint x="256" y="1034" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="9. INSERT Resource (metadata + file_ref)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846" y="1174" as="sourcePoint"/><mxPoint x="1124" y="1174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="Record created / DB error" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1124" y="1212" as="sourcePoint"/><mxPoint x="846" y="1212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="10. Delete file / mark for cleanup" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry x="0.529" relative="1" as="geometry"><mxPoint x="846" y="1423" as="sourcePoint"/><mxPoint x="1394" y="1423" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="Deleted / cleanup queued" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry x="-0.529" relative="1" as="geometry"><mxPoint x="1394" y="1461" as="sourcePoint"/><mxPoint x="846" y="1461" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="500 Internal Error {upload failed}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="1499" as="sourcePoint"/><mxPoint x="536" y="1499" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value="Show «Upload unsuccessful»" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="1537" as="sourcePoint"/><mxPoint x="256" y="1537" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" value="200 OK {resource, status: Under Review}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="1655" as="sourcePoint"/><mxPoint x="536" y="1655" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="Show «Uploaded, awaiting review»" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="1693" as="sourcePoint"/><mxPoint x="256" y="1693" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="201 Created {resource, status: Published}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="1769" as="sourcePoint"/><mxPoint x="536" y="1769" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c59" value="Show «Upload successful» + status" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="1807" as="sourcePoint"/><mxPoint x="256" y="1807" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846" y="404" as="sourcePoint"/><mxPoint x="852" y="428" as="targetPoint"/><Array as="points"><mxPoint x="886" y="404"/><mxPoint x="886" y="428"/></Array></mxGeometry></mxCell><mxCell id="c61" value="5. Verify JWT &amp;amp; upload authorization" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="892" y="406" width="280" height="20" as="geometry"/></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846" y="535" as="sourcePoint"/><mxPoint x="852" y="559" as="targetPoint"/><Array as="points"><mxPoint x="886" y="535"/><mxPoint x="886" y="559"/></Array></mxGeometry></mxCell><mxCell id="c63" value="6. Validate fields, file type &amp;amp; size" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="892" y="537" width="280" height="20" as="geometry"/></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846" y="1110" as="sourcePoint"/><mxPoint x="852" y="1134" as="targetPoint"/><Array as="points"><mxPoint x="886" y="1110"/><mxPoint x="886" y="1134"/></Array></mxGeometry></mxCell><mxCell id="c65" value="8. Run risk checks; set status" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="892" y="1112" width="280" height="20" as="geometry"/></mxCell><mxCell id="c66" value="Invalid/expired JWT or user not verified: 401/403 returned and the flow stops." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1170" y="442" width="200" height="55" as="geometry"/></mxCell><mxCell id="c67" value="File is NOT sent to File Storage; NO Resource record is created." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1170" y="615" width="200" height="55" as="geometry"/></mxCell><mxCell id="c68" value="NO Published Resource record is created." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1170" y="918" width="200" height="40" as="geometry"/></mxCell><mxCell id="c69" value="Resource: resource_id, uploader_id, title, description, category, file_name, file_reference, upload_date, status. The file itself is NOT stored in MariaDB." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1170" y="1226" width="200" height="115" as="geometry"/></mxCell><mxCell id="c70" value="BUSINESS RULES &amp;amp; NOTES&lt;br&gt;1. All verified users can upload resources; admin pre-approval is NOT mandatory. Automated validation and risk checks decide Published vs Under Review.&lt;br&gt;2. MariaDB stores only resource metadata and the file reference/path; the actual file is stored in File Storage (provider not decided).&lt;br&gt;3. Resource statuses: Published, Under Review, Restricted, Removed. Admin can later approve, restrict or remove resources (outside this diagram).&lt;br&gt;4. Communication is HTTPS REST with Email OTP + JWT authentication. The backend framework is not decided. No WebSockets or real-time messaging.&lt;br&gt;5. Alternatives shown: A validation failure, B file storage failure, C database failure (file cleanup), D resource requires review." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1925" width="1420" height="146" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>