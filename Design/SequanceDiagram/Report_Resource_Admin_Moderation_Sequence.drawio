as="geometry"/></mxCell><mxCell id="c157" value="No report data is returned; no changes are made." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1420" y="1943" width="210" height="40" as="geometry"/></mxCell><mxCell id="c158" value="No moderation action is performed." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1420" y="2481" width="210" height="40" as="geometry"/></mxCell><mxCell id="c159" value="No moderation changes are made." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1420" y="3003" width="210" height="40" as="geometry"/></mxCell><mxCell id="c160" value="No moderation action is performed." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1420" y="3291" width="210" height="40" as="geometry"/></mxCell><mxCell id="c161" value="Resource status remains Published." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1420" y="3501" width="210" height="40" as="geometry"/></mxCell><mxCell id="c162" value="Status only: the physical file is NOT deleted from File Storage." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1420" y="4095" width="210" height="55" as="geometry"/></mxCell><mxCell id="c163" value="* ResourceReport moderation updates are application-level and made only where supported by the existing ERD; no columns or statuses are invented." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="4366" width="1200" height="25" as="geometry"/></mxCell><mxCell id="c164" value="BUSINESS RULES &amp;amp; NOTES&lt;br&gt;1. Reporting does NOT automatically remove a resource. Only Admin can moderate (Keep Published / Restrict / Remove); Admin role is verified at the report list and again at the decision.&lt;br&gt;2. Statuses used: Published, Under Review, Restricted, Removed. Keep = remains Published; Restrict = Restricted; Remove = Removed.&lt;br&gt;3. Only the existing Resource and ResourceReport entities are used. * ResourceReport moderation updates are application-level, only where supported by the existing ERD.&lt;br&gt;4. Removing a resource sets its status to Removed only; the physical file is NOT deleted from File Storage.&lt;br&gt;5. HTTPS REST with Email OTP + JWT; backend framework and storage provider TBD; no WebSockets or real-time communication.&lt;br&gt;6. Alternatives: A auth failure, B resource not found, C invalid/duplicate report, D unauthorized admin, E resource or report not found." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="4445" width="1740" height="168" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>