tml=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="422" as="sourcePoint"/><mxPoint x="1200" y="422" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="[else – JWT valid]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="425" width="1000" height="20" as="geometry"/></mxCell><mxCell id="c11" value="A4: Validate &amp; process&lt;br&gt;Friend Request" style="endArrow=block;endFill=1;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="606" y="466" as="sourcePoint"/><mxPoint x="864" y="466" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="Friend request saved" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="864" y="502" as="sourcePoint"/><mxPoint x="606" y="502" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="606" y="538" as="sourcePoint"/><mxPoint x="606" y="578" as="targetPoint"/><Array as="points"><mxPoint x="646" y="538"/><mxPoint x="646" y="578"/></Array></mxGeometry></mxCell><mxCell id="c15" value="A5: Identify recipient&lt;br&gt;(Asad) to notify" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="652" y="538" width="230" height="40" as="geometry"/></mxCell><mxCell id="c16" value="A6: Create &amp; INSERT Notification&lt;br&gt;(user_id = Asad)" style="endArrow=block;endFill=1;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="606" y="606" as="sourcePoint"/><mxPoint x="864" y="606" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="[Alt 3 – Database error: notification not saved]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="645" width="1000" height="20" as="geometry"/></mxCell><mxCell id="c18" value="Error: notification not saved" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="864" y="686" as="sourcePoint"/><mxPoint x="606" y="686" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="Error response: operation not completed" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="722" as="sourcePoint"/><mxPoint x="336" y="722" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="Show error message" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="324" y="758" as="sourcePoint"/><mxPoint x="100" y="758" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="780" as="sourcePoint"/><mxPoint x="1188" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="[else – notification saved]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="783" width="1000" height="20" as="geometry"/></mxCell><mxCell id="c23" value="A7: Insert confirmed" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="864" y="824" as="sourcePoint"/><mxPoint x="606" y="824" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="A8: Friend request response (success)" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="860" as="sourcePoint"/><mxPoint x="336" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="A9: Show Friend Request Sent" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="324" y="896" as="sourcePoint"/><mxPoint x="100" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="B1: Open Notifications section" style="endArrow=block;endFill=1;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="1020" as="sourcePoint"/><mxPoint x="336" y="1020" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="B2: Get notifications (HTTPS, Asad's JWT)" style="endArrow=block;endFill=1;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="336" y="1056" as="sourcePoint"/><mxPoint x="594" y="1056" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="606" y="1092" as="sourcePoint"/><mxPoint x="606" y="1132" as="targetPoint"/><Array as="points"><mxPoint x="646" y="1092"/><mxPoint x="646" y="1132"/></Array></mxGeometry></mxCell><mxCell id="c35" value="B3: Validate JWT &amp;&lt;br&gt;identify authenticated user" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="652" y="1092" width="230" height="40" as="geometry"/></mxCell><mxCell id="c36" value="[Alt 1 – Invalid or expired JWT]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="1153" width="1000" height="20" as="geometry"/></mxCell><mxCell id="c37" value="401: Authentication failed" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="1194" as="sourcePoint"/><mxPoint x="336" y="1194" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="Show authentication error" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="336" y="1230" as="sourcePoint"/><mxPoint x="1120" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="1252" as="sourcePoint"/><mxPoint x="1200" y="1252" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="[else – JWT valid]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="1255" width="1000" height="20" as="geometry"/></mxCell><mxCell id="c41" value="B4: Query Notification&lt;br&gt;(user_id = authenticated user)" style="endArrow=block;endFill=1;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="606" y="1306" as="sourcePoint"/><mxPoint x="864" y="1306" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="[Alt 4 – Database error during retrieval]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="1345" width="1000" height="20" as="geometry"/></mxCell><mxCell id="c43" value="Error: retrieval failed" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="864" y="1386" as="sourcePoint"/><mxPoint x="606" y="1386" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="500: Failed to load notifications" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="1422" as="sourcePoint"/><mxPoint x="336" y="1422" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="Show error message" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="336" y="1458" as="sourcePoint"/><mxPoint x="1120" y="1458" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1480" as="sourcePoint"/><mxPoint x="1188" y="1480" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="[else – query succeeded]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="1483" width="1000" height="20" as="geometry"/></mxCell><mxCell id="c48" value="B5: Notification records" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="864" y="1524" as="sourcePoint"/><mxPoint x="606" y="1524" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="[Alt 2 – No notifications available]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="124" y="1563" width="1000" height="20" as="geometry"/></mxCell><mxCell id="c51" value="Empty notification list" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="1604" as="sourcePoint"/><mxPoint x="336" y="1604" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="Show: No notifications yet" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="336" y="1640" as="sourcePoint"/><mxPoint x="1120" y="1640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="64" y="1662" as="sourcePoint"/><mxPoint x="1176" y="1662" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="[else – notifications found]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="124" y="1665" width="1000" height="20" as="geometry"/></mxCell><mxCell id="c55" value="B6: Notification data" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="1706" as="sourcePoint"/><mxPoint x="336" y="1706" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" value="B7: Display notifications" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="336" y="1742" as="sourcePoint"/><mxPoint x="1120" y="1742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rules" value="&lt;b&gt;Business rules&lt;/b&gt;&lt;br&gt;• Each Notification belongs to its intended recipient (Notification.user_id); only the authenticated user can retrieve their own notifications.&lt;br&gt;• Uses the existing Notification entity only (notification_id, user_id, type, message, is_read, created_at). No new entities, fields or status values.&lt;br&gt;• Friend Request is only an example: Mentorship, Community Discussions and Project Collaboration can also generate notifications the same way.&lt;br&gt;• Notifications are stored and fetched through normal HTTPS REST requests on demand. No WebSockets, live delivery or push provider is assumed." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="1836" width="1160" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>