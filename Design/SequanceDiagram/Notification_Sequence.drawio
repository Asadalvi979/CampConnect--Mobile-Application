<mxfile><diagram name="Notification Sequence"><mxGraphModel adaptiveColors="auto" page="1" pageWidth="1260" pageHeight="1996"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="CampConnect – Notification Generation and Retrieval (Sequence Diagram)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1000" height="34" as="geometry"/></mxCell><mxCell id="LF" value="Flutter Mobile App" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=12;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="255" y="70" width="150" height="1756" as="geometry"/></mxCell><mxCell id="LB" value="Dart Backend API&lt;br&gt;&lt;small&gt;(Framework TBD)&lt;/small&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=12;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="525" y="70" width="150" height="1756" as="geometry"/></mxCell><mxCell id="LD" value="MariaDB Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=12;fontStyle=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="795" y="70" width="150" height="1756" as="geometry"/></mxCell><mxCell id="LSA" value="Initiating User&lt;br&gt;(Bilal)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="70" width="30" height="50" as="geometry"/></mxCell><mxCell id="LSAl" style="endArrow=none;dashed=1;html=1;strokeColor=#666666;" edge="1" pare