block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="986" y="842" as="sourcePoint"/><mxPoint x="992" y="866" as="targetPoint"/><Array as="points"><mxPoint x="1026" y="842"/><mxPoint x="1026" y="866"/></Array></mxGeometry></mxCell><mxCell id="c172" value="P10. Verify JWT" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1032" y="844" width="280" height="20" as="geometry"/></mxCell><mxCell id="c173" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="986" y="1387" as="sourcePoint"/><mxPoint x="992" y="1411" as="targetPoint"/><Array as="points"><mxPoint x="1026" y="1387"/><mxPoint x="1026" y="1411"/></Array></mxGeometry></mxCell><mxCell id="c174" value="P12. Validate post content" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1032" y="1389" width="280" height="20" as="geometry"/></mxCell><mxCell id="c175" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="986" y="2208" as="sourcePoint"/><mxPoint x="992" y="2232" as="targetPoint"/><Array as="points"><mxPoint x="1026" y="2208"/><mxPoint x="1026" y="2232"/></Array></mxGeometry></mxCell><mxCell id="c176" value="C6. Verify JWT" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1032" y="2210" width="280" height="20" as="geometry"/></mxCell><mxCell id="c177" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="986" y="2933" as="sourcePoint"/><mxPoint x="992" y="2957" as="targetPoint"/><Array as="points"><mxPoint x="1026" y="2933"/><mxPoint x="1026" y="2957"/></Array></mxGeometry></mxCell><mxCell id="c178" value="C8. Validate comment content" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1032" y="2935" width="280" height="20" as="geometry"/></mxCell><mxCell id="c179" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="986" y="3614" as="sourcePoint"/><mxPoint x="992" y="3638" as="targetPoint"/><Array as="points"><mxPoint x="1026" y="3614"/><mxPoint x="1026" y="3638"/></Array></mxGeometry></mxCell><mxCell id="c180" value="L4. Verify JWT" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1032" y="3616" width="280" height="20" as="geometry"/></mxCell><mxCell id="c181" value="No Post record is created." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="922" width="320" height="25" as="geometry"/></mxCell><mxCell id="c182" value="Not every user can post in every community. No Post is created." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="1195" width="320" height="40" as="geometry"/></mxCell><mxCell id="c183" value="No Post record is created." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="1467" width="320" height="25" as="geometry"/></mxCell><mxCell id="c184" value="No Comment record is created." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="2288" width="320" height="25" as="geometry"/></mxCell><mxCell id="c185" value="No Comment record is created." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="2561" width="320" height="25" as="geometry"/></mxCell><mxCell id="c186" value="Permission denied: no Comment record is created." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="2756" width="320" height="25" as="geometry"/></mxCell><mxCell id="c187" value="No Comment record is created." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="3013" width="320" height="25" as="geometry"/></mxCell><mxCell id="c188" value="One PostLike per user and post: existence is checked before INSERT, so duplicates are prevented." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="4120" width="320" height="55" as="geometry"/></mxCell><mxCell id="c189" value="BUSINESS RULES &amp;amp; NOTES&lt;br&gt;1. Only authenticated users (valid JWT) can create posts, comments and likes; the JWT is verified first on every request.&lt;br&gt;2. Posting and commenting require community permission (CommunityMembership); not every user can post in every community.&lt;br&gt;3. A Post belongs to an existing Community and a Comment belongs to an existing Post; no record is created when any check fails.&lt;br&gt;4. One PostLike per user and post: existence is checked before INSERT; Like again = Unlike (DELETE), so duplicate likes cannot be created.&lt;br&gt;5. Entities used: Community, CommunityMembership, Post, Comment, PostLike (no new entities). HTTPS REST with Email OTP + JWT; framework TBD; no WebSockets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="5009" width="1500" height="146" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>