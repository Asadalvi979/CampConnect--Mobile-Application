 height="20" as="geometry"/></mxCell><mxCell id="c120" value="C9: Update confirmed" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="914" y="3434" as="sourcePoint"/><mxPoint x="646" y="3434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c122" value="C10: Success: account reactivated" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="634" y="3470" as="sourcePoint"/><mxPoint x="366" y="3470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c123" value="C11: Show User Reactivated confirmation" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="354" y="3506" as="sourcePoint"/><mxPoint x="100" y="3506" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rules" value="&lt;b&gt;Business rules&lt;/b&gt;&lt;br&gt;• Only authenticated Admins can suspend or reactivate accounts; Admin authorization is verified before any account operation. Existing accounts only.&lt;br&gt;• Uses the existing User entity only (account_status). No new entities, fields or relationships. ERD note: account_status is an ENUM whose values are not listed, so the suspended and active states are shown by name only.&lt;br&gt;• Suspended users cannot access protected features; reactivated users regain access under their existing roles. Suspension does not delete user data.&lt;br&gt;• Registration, login and account deletion are out of scope. Normal HTTPS REST requests only; no WebSockets." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="3632" width="1000" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>