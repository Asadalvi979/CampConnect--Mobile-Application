y"/></mxCell><mxCell id="c75" value="Error: update failed" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="914" y="2218" as="sourcePoint"/><mxPoint x="646" y="2218" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c76" value="500: Failed to save decision" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="634" y="2254" as="sourcePoint"/><mxPoint x="366" y="2254" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c77" value="Show failure message" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="354" y="2290" as="sourcePoint"/><mxPoint x="100" y="2290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c78" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="88" y="2312" as="sourcePoint"/><mxPoint x="992" y="2312" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c79" value="[else – update saved]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="148" y="2315" width="800" height="20" as="geometry"/></mxCell><mxCell id="c80" value="15: Update confirmed" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="914" y="2356" as="sourcePoint"/><mxPoint x="646" y="2356" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c82" value="16: Success: interest rejected" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="634" y="2392" as="sourcePoint"/><mxPoint x="366" y="2392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c83" value="17: Show Interest Rejected" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="354" y="2428" as="sourcePoint"/><mxPoint x="100" y="2428" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rules" value="&lt;b&gt;Business rules&lt;/b&gt;&lt;br&gt;• Only the owner of the project (ProjectOpportunity.creator_id) can accept or reject its interests.&lt;br&gt;• Only existing, undecided ProjectInterest records can be processed; a processed interest is never processed again.&lt;br&gt;• Uses existing entities only. Accepting an interest does not create a Friendship, Mentorship, team or membership record.&lt;br&gt;• ERD note: ProjectInterest.status is an ENUM, but the ERD does not list its values. Labels show the decision (Accept / Reject); exact values must be taken from the SRS/SQL phase.&lt;br&gt;• Normal HTTPS REST requests only; no WebSockets or real-time messaging." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="2586" width="1000" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>