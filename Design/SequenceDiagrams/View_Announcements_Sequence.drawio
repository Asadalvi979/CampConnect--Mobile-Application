yle=1;" vertex="1" parent="1"><mxGeometry x="100" y="1365" width="800" height="20" as="geometry"/></mxCell><mxCell id="c45" value="11: Query Announcement&lt;br&gt;by announcement_id" style="endArrow=block;endFill=1;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="646" y="1416" as="sourcePoint"/><mxPoint x="914" y="1416" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="[Alt 4 – Database error]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="1455" width="800" height="20" as="geometry"/></mxCell><mxCell id="c47" value="Error: retrieval failed" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="914" y="1496" as="sourcePoint"/><mxPoint x="646" y="1496" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="500: Failed to load announcement" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="634" y="1532" as="sourcePoint"/><mxPoint x="366" y="1532" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="Show error message" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="354" y="1568" as="sourcePoint"/><mxPoint x="100" y="1568" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1590" as="sourcePoint"/><mxPoint x="1028" y="1590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="[else – query succeeded]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="1593" width="800" height="20" as="geometry"/></mxCell><mxCell id="c52" value="12: Announcement details or none" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="914" y="1634" as="sourcePoint"/><mxPoint x="646" y="1634" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="[Alt 3 – Announcement not found or not accessible]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="124" y="1673" width="800" height="20" as="geometry"/></mxCell><mxCell id="c55" value="404: Announcement not found" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="634" y="1714" as="sourcePoint"/><mxPoint x="366" y="1714" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" value="Show not-found message" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="354" y="1750" as="sourcePoint"/><mxPoint x="100" y="1750" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="64" y="1772" as="sourcePoint"/><mxPoint x="1016" y="1772" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="[else – announcement found and published]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="124" y="1775" width="800" height="20" as="geometry"/></mxCell><mxCell id="c59" value="13: Announcement details" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="634" y="1816" as="sourcePoint"/><mxPoint x="366" y="1816" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value="14: Display full announcement" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="354" y="1852" as="sourcePoint"/><mxPoint x="100" y="1852" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rules" value="&lt;b&gt;Business rules&lt;/b&gt;&lt;br&gt;• Only authenticated users (Student, Senior, Alumni) can view announcements, and only published ones; unpublished or inaccessible announcements return not found.&lt;br&gt;• Uses the existing Announcement entity only (announcement_id, admin_id, title, content, status, published_at). No new entities, fields or status values; no role-specific filtering or audience targeting is assumed.&lt;br&gt;• ERD note: Announcement.status is an ENUM whose values are not listed, so how published is stored must be confirmed in the SRS/SQL phase.&lt;br&gt;• Creation, editing and deletion are out of scope. Normal HTTPS REST requests only; no WebSockets or real-time communication." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="1946" width="1000" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>