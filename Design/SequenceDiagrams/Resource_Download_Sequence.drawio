" parent="1"><mxGeometry x="112" y="1277" width="1312" height="294" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="616" as="sourcePoint"/><mxPoint x="1460" y="616" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="64" y="889" as="sourcePoint"/><mxPoint x="1448" y="889" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="88" y="1161" as="sourcePoint"/><mxPoint x="1436" y="1161" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="112" y="1395" as="sourcePoint"/><mxPoint x="1424" y="1395" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="[JWT is invalid, missing, or expired]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="856" y="447" width="560" height="18" as="geometry"/></mxCell><mxCell id="c18" value="[JWT valid and user authorized]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="856" y="620" width="560" height="18" as="geometry"/></mxCell><mxCell id="c19" value="[Resource ID does not exist in MariaDB]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontStyle=1;spacingLeft=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="856" y=