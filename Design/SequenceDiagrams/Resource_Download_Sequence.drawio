nt="1"><mxGeometry x="834" y="366" width="12" height="1089" as="geometry"/></mxCell><mxCell id="c34" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="530" y="1493" width="12" height="24" as="geometry"/></mxCell><mxCell id="c35" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="524" y="326" width="12" height="1229" as="geometry"/></mxCell><mxCell id="c36" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="244" y="320" width="12" height="1241" as="geometry"/></mxCell><mxCell id="c37" value="1. Open Resources section" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="256" y="170" as="sourcePoint"/><mxPoint x="524" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="Display available resources" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="208" as="sourcePoint"/><mxPoint x="256" y="208" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="2. Select a resource" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="256" y="248" as="sourcePoint"/><mxPoint x="524" y="248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="Show details + «Download» button" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="286" as="sourcePoint"/><mxPoint x="256" y="286" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="3. Tap «Download»" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="256" y="326" as="sourcePoint"/><mxPoint x="524" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="4. GET /api/resources/{id}/download + JWT" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="536" y="366" as="sourcePoint"/><mxPoint x="834" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="401 Unauthorized" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="562" as="sourcePoint"/><mxPoint x="536" y="562" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="Show authentication error" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="600" as="sourcePoint"/><mxPoint x="256" y="600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="6. SELECT Resource WHERE id = {id}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846" y="678" as="sourcePoint"/><mxPoint x="1124" y="678" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="Metadata (status, file_ref) / none" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1124" y="716" as="sourcePoint"/><mxPoint x="846" y="716" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="404 Not Found" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="835" as="sourcePoint"/><mxPoint x="536" y="835" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="Show «Resource not found»" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="873" as="sourcePoint"/><mxPoint x="256" y="873" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="403 Forbidden {access denied}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="1107" as="sourcePoint"/><mxPoint x="536" y="1107" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="Show «Resource not available»" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="1145" as="sourcePoint"/><mxPoint x="256" y="1145" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="8. Retrieve file (file_reference)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry x="0.529" relative="1" as="geometry"><mxPoint x="846" y="1223" as="sourcePoint"/><mxPoint x="1394" y="1223" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="File / storage error" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry x="-0.529" relative="1" as="geometry"><mxPoint x="1394" y="1261" as="sourcePoint"/><mxPoint x="846" y="1261" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="502 Bad Gateway {download failed}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="1341" as="sourcePoint"/><mxPoint x="536" y="1341" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="Show «Download failed»" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="1379" as="sourcePoint"/><mxPoint x="256" y="1379" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value="200 OK {file}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="1455" as="sourcePoint"/><mxPoint x="536" y="1455" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" value="Show «Download successful»" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="1555" as="sourcePoint"/><mxPoint x="256" y="1555" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846" y="404" as="sourcePoint"/><mxPoint x="852" y="428" as="targetPoint"/><Array as="points"><mxPoint x="886" y="404"/><mxPoint x="886" y="428"/></Array></mxGeometry></mxCell><mxCell id="c58" value="5. Verify JWT &amp;amp; authorization" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="892" y="406" width="280" height="20" as="geometry"/></mxCell><mxCell id="c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846" y="949" as="sourcePoint"/><mxPoint x="852" y="973" as="targetPoint"/><Array as="points"><mxPoint x="886" y="949"/><mxPoint x="886" y="973"/></Array></mxGeometry></mxCell><mxCell id="c60" value="7. Check resource status" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="892" y="951" width="280" height="20" as="geometry"/></mxCell><mxCell id="c61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="536" y="1493" as="sourcePoint"/><mxPoint x="542" y="1517" as="targetPoint"/><Array as="points"><mxPoint x="576" y="1493"/><mxPoint x="576" y="1517"/></Array></mxGeometry></mxCell><mxCell id="c62" value="9. Save file on device" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="582" y="1495" width="280" height="20" as="geometry"/></mxCell><mxCell id="c63" value="Resource is NOT queried and File Storage is NOT accessed." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1170" y="484" width="200" height="40" as="geometry"/></mxCell><mxCell id="c64" value="File Storage is NOT accessed." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1170" y="772" width="200" height="25" as="geometry"/></mxCell><mxCell id="c65" value="Download denied; file is NOT retrieved from File Storage." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1170" y="1029" width="200" height="40" as="geometry"/></mxCell><mxCell id="c66" value="BUSINESS RULES &amp;amp; NOTES&lt;br&gt;1. The backend verifies the JWT before any resource lookup. Only Published resources can be downloaded.&lt;br&gt;2. Under Review, Restricted and Removed resources are denied (403); the status is checked BEFORE File Storage is accessed.&lt;br&gt;3. MariaDB returns metadata and the file reference only; the actual file is provided by File Storage (provider not decided).&lt;br&gt;4. No new database entity is used for downloads. Communication is HTTPS REST with Email OTP + JWT; backend framework TBD; no WebSockets.&lt;br&gt;5. Alternatives shown: A authentication failure, B resource not found, C resource not published, D file storage failure." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1673" width="1420" height="146" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>