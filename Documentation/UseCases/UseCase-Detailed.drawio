        <mxCell id="n1" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;size=14;" value="&lt;b&gt;Business rules&lt;/b&gt;&lt;br&gt;• Private messaging requires the recipient to accept a message request.&lt;br&gt;• An accepted mentorship request authorizes Student/Senior ↔ Alumni communication; alumni messaging is not unrestricted.&lt;br&gt;• Resources are published after automated validation (no mandatory pre-approval); reported/risk-flagged ones go Under Review → Published / Restricted / Removed.&lt;br&gt;• Senior inherits all Student use cases (generalization), so no duplicate associations." vertex="1">
          <mxGeometry height="150" width="720" x="200" y="1314" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;size=14;" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;━&lt;/font&gt; Student association&lt;br&gt;&lt;font color=&quot;#15803D&quot;&gt;━&lt;/font&gt; Alumni association&lt;br&gt;&lt;font color=&quot;#7C3AED&quot;&gt;━&lt;/font&gt; Senior-only association&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;━&lt;/font&gt; Admin association&lt;br&gt;▷ Generalization (Senior → Student)&lt;br&gt;┄&gt; «include» / «extend»" vertex="1">
          <mxGeometry height="150" width="300" x="940" y="1314" as="geometry" />
